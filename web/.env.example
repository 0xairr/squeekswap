# Server-only Sepolia RPC for the offer, wheel-round and claim readers and the /api/rpc gateway.
# Default: publicnode, with Tenderly's public gateway as a full-history fallback. A keyed archive RPC is recommended.
SEPOLIA_RPC_URL=
LOG_CHUNK=10000
INDEX_CACHE_DIR=

# Optional deployment-registry overrides. Leave blank for the checked-in Sepolia deployment.
NEXT_PUBLIC_SWAP_ADDRESS=
NEXT_PUBLIC_SWAP_FROM_BLOCK=

# Local development only.
NEXT_PUBLIC_ENABLE_LOCAL=
LOCAL_RPC_URL=
