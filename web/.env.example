# Server-only RPC for the shared offer-event index.
SEPOLIA_RPC_URL=
LOG_CHUNK=10000
INDEX_CACHE_DIR=

# Browser RPC. Use a domain-restricted key if this is not a public endpoint.
NEXT_PUBLIC_SEPOLIA_RPC=

# Optional deployment-registry overrides. Leave blank for the checked-in Sepolia deployment.
NEXT_PUBLIC_SWAP_ADDRESS=
NEXT_PUBLIC_SWAP_FROM_BLOCK=

# Local development only.
NEXT_PUBLIC_ENABLE_LOCAL=
LOCAL_RPC_URL=
